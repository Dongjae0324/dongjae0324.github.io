@inproceedings{jeon2026lcr_diversity,
  title={Low-Confidence Remasking Traps Flexibility: Realizing Arbitrary-Order Potential for Diverse Rollouts in Diffusion LLMs},
  author = {Jeon, Moongyu and Jeon, Dongjae and Kim, Bumjun and Kim, Mingyu and No, Albert},
  coauthor={Moongyu Jeon, Dongjae Jeon},
  booktitle  = {NeurIPS BeNTo, DiffuLM workshop},
  year      = {2026},
  pub_id = {W2},
  html = {https://arxiv.org/abs/2609.34509},
  img = {assets/img/publications/comingsoon.jpg},
  tldr = {We trace the diversity loss of arbitrary-order decoding in diffusion LLMs not to the generation order itself, but to low-confidence remasking (LCR), which exponentially suppresses lower-probability tokens as more positions compete. Switching to top-probability position selection (TPP) restores diversity with Pass@k comparable to left-to-right decoding, and Entropy-Guided Initialization (EGI) further improves rollout diversity, solution coverage, and downstream policy optimization.},
}

